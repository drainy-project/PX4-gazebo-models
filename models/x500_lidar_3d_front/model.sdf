<?xml version="1.0" encoding="UTF-8"?>
<sdf version='1.9'>
  <model name='x500_lidar_3d_front'>
    <include merge='true'>
      <uri>x500</uri>
    </include>
    <include merge='true'>
      <uri>model://lidar_3d_v1</uri>
      <pose relative_to="base_link">0 0 0.075 0 0 0</pose>
    </include>
    <joint name="lidar_model_joint" type="fixed">
      <parent>base_link</parent>
      <child>lidar_sensor_link</child>
      <pose relative_to="base_link">0 0 0 0 0 0</pose>
    </joint>
    <joint name="lidar_joint" type="fixed">
      <parent>base_link</parent>
      <child>lidar_3d_link</child>
      <pose relative_to="base_link">0 0 0 0 0 0</pose>
    </joint>
    <link name="lidar_sensor_link">
      <!-- <pose relative_to="base_link">0 0 0 0 0 0</pose> -->
      <inertial>
        <mass>0.001</mass>
        <inertia>
          <ixx>0.00001</ixx>
          <iyy>0.00001</iyy>
          <izz>0.00001</izz>
          <ixy>0.0</ixy>
          <ixz>0.0</ixz>
          <iyz>0.0</iyz>
        </inertia>
      </inertial>
      <sensor name='lidar_3d' type='gpu_lidar'>
        <topic>lidar_3d</topic>
        <gz_frame_id>lidar_sensor_link</gz_frame_id>
        <!-- <pose relative_to="base_link">0 0 0 0 0 0</pose> -->
        <update_rate>20</update_rate>
        <ray>
          <scan>
            <horizontal>
              <samples>1024</samples>
              <resolution>1</resolution>
              <min_angle>-3.141592</min_angle>
              <max_angle>3.141592</max_angle>
            </horizontal>
            <vertical>
              <samples>32</samples>
              <resolution>1</resolution>
              <min_angle>-0.37</min_angle>
              <max_angle>0.37</max_angle>
            </vertical>
          </scan>
          <range>
            <min>2.0</min>
            <max>200.0</max>
            <resolution>0.05</resolution>
          </range>
        </ray>
        <always_on>1</always_on>
        <visualize>true</visualize>
      </sensor>
    </link>
  </model>
</sdf>
