<?xml version="1.0" encoding="UTF-8"?>
<sdf version='1.9'>
  <model name='realsense_d435'>
    <pose>0 0 0 0 0 0</pose>
    <self_collide>false</self_collide>
    <static>false</static>
    <link name="camera_link">
      <inertial>
        <pose>0 0 0 0 0 0</pose>
        <mass>0.061</mass>
        <inertia>
          <ixx>0.0000460804</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.0000055421</iyy>
          <iyz>0</iyz>
          <izz>0.0000436519</izz>
        </inertia>
      </inertial>
      <visual name="realsense_d435/visual">
        <pose>0.023 0 0 1.57 0 1.57</pose>
        <geometry>
          <mesh>
            <scale>1 1 1</scale>
            <uri>model://realsense_d435/meshes/realsense_435.dae</uri>
          </mesh>
        </geometry>
      </visual>
      <collision name="realsense_d435/collision">
        <pose>0.015 0 0 0 0 0</pose>
        <geometry>
          <box>
            <size>0.03 0.09 0.03</size>
          </box>
        </geometry>
      </collision>
      <sensor name="camera_image" type="camera">
        <gz_frame_id>camera_link</gz_frame_id>
        <pose>0 -0.017 0 0 0 0</pose>
        <camera>
          <horizontal_fov>1.204</horizontal_fov>
          <image>
            <width>1920</width>
            <height>1080</height>
          </image>
          <clip>
            <near>0.1</near>
            <far>100</far>
          </clip>
        </camera>
        <always_on>1</always_on>
        <update_rate>30</update_rate>
        <visualize>true</visualize>
      </sensor>
      <sensor name="camera_depth" type="depth_camera">
        <gz_frame_id>camera_link</gz_frame_id>
        <pose>0 -0.004 0 0 0 0</pose>
        <camera>
          <horizontal_fov>1.274</horizontal_fov>
          <image>
            <width>848</width>
            <height>480</height>
            <format>R_FLOAT32</format>
          </image>
          <clip>
            <near>0.3</near>
            <far>10</far>
          </clip>
        </camera>
        <always_on>1</always_on>
        <update_rate>30</update_rate>
        <visualize>true</visualize>
        <topic>depth_camera</topic>
      </sensor>
      <gravity>true</gravity>
      <velocity_decay />
    </link>
    <!-- <plugin filename="ignition-gazebo-sensors-system"
    name="ignition::gazebo::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin> -->
  </model>
</sdf>
